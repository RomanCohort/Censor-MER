{
  "name": "Censor-Feedback",
  "version": "1.0.0",
  "description": "微表情反馈收集系统 - 简洁选择式界面（嵌入Python）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "setup-python": "setup_embedded_python.bat",
    "build": "electron-builder --win",
    "build:full": "npm run setup-python && npm run build",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "pack": "electron-builder --dir"
  },
  "author": "Censor Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.censor.feedback",
    "productName": "Censor 微表情反馈",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Censor 微表情反馈"
    },
    "files": [
      "main.js",
      "preload.js",
      "*.html",
      "icon.*",
      "!embedded/python_embed.zip",
      "!embedded/get-pip.py"
    ],
    "extraResources": [
      {
        "from": "embedded",
        "to": "embedded",
        "filter": ["**/*", "!*.zip", "!*.pyc"]
      },
      {
        "from": "../interface",
        "to": "interface",
        "filter": ["**/*.py"]
      },
      {
        "from": "../model",
        "to": "model",
        "filter": ["**/*.py"]
      },
      {
        "from": "../config",
        "to": "config",
        "filter": ["**/*.py", "**/*.yaml"]
      },
      {
        "from": "../feedback_data",
        "to": "feedback_data",
        "filter": ["**/*"]
      }
    ]
  }
}